{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-loom.example/schemas/v1/template.schema.json",
  "title": "Design Loom template",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
    },
    "content_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "heading",
          "required",
          "guidance"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "artifact_type",
    "content_path",
    "sections"
  ],
  "additionalProperties": false
}
