{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-loom.example/schemas/v1/source.schema.json",
  "title": "Design Loom source",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
    },
    "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "git",
        "file",
        "documentation",
        "database",
        "design",
        "context"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "captured",
        "missing"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\u0000]+$"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "application_id",
    "provider",
    "locator",
    "revision",
    "retrieved_at",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "captured"
          }
        }
      },
      "then": {
        "required": [
          "sha256"
        ]
      }
    }
  ]
}
