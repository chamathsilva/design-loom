{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-loom.example/schemas/v1/workspace.schema.json",
  "title": "Design Loom workspace",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,79}$"
          },
          "checkout_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "checkout_path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9.-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "repositories"
  ],
  "additionalProperties": false
}
